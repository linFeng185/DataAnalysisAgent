{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "文档证据提取输出",
  "type": "object",
  "required": ["citations", "potential_conflicts", "untrusted_content_detected", "insufficient_evidence", "method"],
  "properties": {
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["content", "source_id", "version", "locator", "scores", "metadata"],
        "properties": {
          "content": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "locator": {"type": "object", "minProperties": 1},
          "scores": {"type": "object", "additionalProperties": {"type": "number"}},
          "metadata": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "potential_conflicts": {"type": "array", "items": {"type": "object"}},
    "untrusted_content_detected": {"type": "boolean"},
    "insufficient_evidence": {"type": "boolean"},
    "method": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
