{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "数据质量检查输入",
  "type": "object",
  "required": ["rows", "column"],
  "properties": {
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    },
    "column": {"type": "string", "minLength": 1, "maxLength": 256},
    "threshold": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10,
      "default": 3.0
    }
  },
  "additionalProperties": false
}
