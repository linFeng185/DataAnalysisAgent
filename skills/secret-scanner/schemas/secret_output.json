{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "工程凭据扫描输出",
  "type": "object",
  "required": ["contains_sensitive_material", "summary", "category_counts", "findings", "findings_truncated", "raw_values_returned", "action"],
  "properties": {
    "contains_sensitive_material": {"type": "boolean"},
    "summary": {
      "type": "object",
      "required": ["document_count", "scanned_characters", "total_findings", "suppressed_findings"],
      "properties": {
        "document_count": {"type": "integer", "minimum": 0},
        "scanned_characters": {"type": "integer", "minimum": 0},
        "total_findings": {"type": "integer", "minimum": 0},
        "suppressed_findings": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "category_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "locator", "category", "severity", "start", "end", "fingerprint", "reason"],
        "properties": {
          "source_id": {"type": "string"},
          "locator": {"type": "object"},
          "category": {"type": "string", "enum": ["private_key", "jwt", "cloud_access_key", "source_control_token", "connection_uri", "assigned_credential"]},
          "severity": {"type": "string", "enum": ["high", "critical"]},
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 0},
          "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "findings_truncated": {"type": "boolean"},
    "raw_values_returned": {"const": false},
    "action": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
