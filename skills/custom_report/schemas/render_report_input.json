{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["template", "data"],
  "properties": {
    "template": {"type": "string", "enum": ["weekly_report", "monthly_report"]},
    "data": {
      "type": "object",
      "required": ["title", "summary", "insights", "metrics"],
      "properties": {
        "title": {"type": "string"},
        "summary": {"type": "string"},
        "insights": {"type": "array", "items": {"type": "string"}},
        "metrics": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
