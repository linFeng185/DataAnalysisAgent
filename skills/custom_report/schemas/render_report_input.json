{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "周期报告渲染输入",
  "type": "object",
  "required": ["template", "data"],
  "properties": {
    "template": {"type": "string", "enum": ["weekly_report", "monthly_report"]},
    "data": {
      "type": "object",
      "required": ["title", "summary", "insights", "metrics"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "summary": {"type": "string", "maxLength": 20000},
        "insights": {
          "type": "array",
          "maxItems": 200,
          "items": {"type": "string", "maxLength": 5000}
        },
        "metrics": {
          "type": "object",
          "maxProperties": 500,
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        },
        "period": {"type": "string", "maxLength": 200},
        "generated_at": {"type": "string", "maxLength": 200},
        "recommendations": {
          "type": "array",
          "maxItems": 200,
          "items": {"type": "string", "maxLength": 5000}
        },
        "changes": {
          "type": "object",
          "maxProperties": 500,
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        },
        "next_steps": {
          "type": "array",
          "maxItems": 200,
          "items": {"type": "string", "maxLength": 5000}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
