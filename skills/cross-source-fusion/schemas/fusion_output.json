{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "跨源连接检查输出",
  "type": "object",
  "required": ["decision", "contract", "join_preview", "preview_truncated", "limitations"],
  "properties": {
    "decision": {"type": "string", "enum": ["ready", "blocked", "confirmed"]},
    "contract": {
      "type": "object",
      "required": ["left_asset_id", "right_asset_id", "left_key", "right_key", "left_rows", "right_rows", "matched_left_rows", "matched_rows", "match_rate", "unmatched_left_rows", "unmatched_right_rows", "cardinality", "expansion_factor", "requires_confirmation", "confirmation_reason"],
      "properties": {
        "left_asset_id": {"type": "string"},
        "right_asset_id": {"type": "string"},
        "left_key": {"type": "string"},
        "right_key": {"type": "string"},
        "left_rows": {"type": "integer", "minimum": 0},
        "right_rows": {"type": "integer", "minimum": 0},
        "matched_left_rows": {"type": "integer", "minimum": 0},
        "matched_rows": {"type": "integer", "minimum": 0},
        "match_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "unmatched_left_rows": {"type": "integer", "minimum": 0},
        "unmatched_right_rows": {"type": "integer", "minimum": 0},
        "cardinality": {"type": "string", "enum": ["one_to_one", "one_to_many", "many_to_one", "many_to_many"]},
        "expansion_factor": {"type": "number", "minimum": 0},
        "requires_confirmation": {"type": "boolean"},
        "confirmation_reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "join_preview": {"type": "array", "items": {"type": "object"}},
    "preview_truncated": {"type": "boolean"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
