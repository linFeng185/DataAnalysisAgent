{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "技能质量评测输出",
  "type": "object",
  "required": ["gate_passed", "minimum_score", "average_score", "summary", "case_results", "nondeterministic_cases", "schema_failures", "slow_cases", "filesystem_accessed", "untrusted_code_executed"],
  "properties": {
    "gate_passed": {"type": "boolean"},
    "minimum_score": {"type": "number", "minimum": 0, "maximum": 1},
    "average_score": {"type": "number", "minimum": 0, "maximum": 1},
    "summary": {
      "type": "object",
      "required": ["total_cases", "passed_cases", "failed_cases"],
      "properties": {
        "total_cases": {"type": "integer", "minimum": 1},
        "passed_cases": {"type": "integer", "minimum": 0},
        "failed_cases": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "case_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "passed", "score", "checks"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "checks": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "required": ["name", "passed", "message"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "passed": {"type": "boolean"},
                "message": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "nondeterministic_cases": {"type": "array", "items": {"type": "string"}},
    "schema_failures": {"type": "array", "items": {"type": "string"}},
    "slow_cases": {"type": "array", "items": {"type": "string"}},
    "filesystem_accessed": {"const": false},
    "untrusted_code_executed": {"const": false}
  },
  "additionalProperties": false
}
