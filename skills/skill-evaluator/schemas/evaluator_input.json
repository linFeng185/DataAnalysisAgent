{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "技能质量评测输入",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["case_id", "output", "output_schema", "duration_ms"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "output": {},
          "output_schema": {"type": "object"},
          "expected_subset": {"type": "object", "default": {}},
          "repeat_outputs": {"type": "array", "default": [], "items": {}},
          "duration_ms": {"type": "number", "minimum": 0},
          "error": {"type": ["string", "null"], "default": null}
        },
        "additionalProperties": false
      }
    },
    "minimum_score": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.95},
    "maximum_duration_ms": {"type": "number", "exclusiveMinimum": 0, "default": 1000}
  },
  "additionalProperties": false
}
