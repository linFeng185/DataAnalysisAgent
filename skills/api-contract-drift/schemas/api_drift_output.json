{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "接口契约漂移输出",
  "type": "object",
  "required": ["compatible", "breaking_changes", "compatible_changes", "informational_changes", "summary"],
  "$defs": {
    "change": {
      "type": "object",
      "required": ["code", "path", "before", "after", "reason"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "before": {},
        "after": {},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "compatible": {"type": "boolean"},
    "breaking_changes": {"type": "array", "items": {"$ref": "#/$defs/change"}},
    "compatible_changes": {"type": "array", "items": {"$ref": "#/$defs/change"}},
    "informational_changes": {"type": "array", "items": {"$ref": "#/$defs/change"}},
    "summary": {
      "type": "object",
      "required": ["breaking", "compatible", "informational", "total"],
      "properties": {
        "breaking": {"type": "integer", "minimum": 0},
        "compatible": {"type": "integer", "minimum": 0},
        "informational": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
