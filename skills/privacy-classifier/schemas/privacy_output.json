{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "隐私分类输出",
  "type": "object",
  "required": ["contains_sensitive_data", "classified_columns", "sensitive_columns", "critical_columns", "detections", "category_match_counts", "raw_values_returned", "action"],
  "properties": {
    "contains_sensitive_data": {"type": "boolean"},
    "classified_columns": {"type": "integer", "minimum": 0},
    "sensitive_columns": {"type": "array", "items": {"type": "string"}},
    "critical_columns": {"type": "array", "items": {"type": "string"}},
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["column", "category", "sensitivity", "confidence", "match_count", "non_null_count", "reasons", "sample_hashes"],
        "properties": {
          "column": {"type": "string", "minLength": 1},
          "category": {"type": "string", "enum": ["email", "phone", "id_card", "bank_card", "ip_address", "credential", "person_name", "address"]},
          "sensitivity": {"type": "string", "enum": ["medium", "high", "critical"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "match_count": {"type": "integer", "minimum": 0},
          "non_null_count": {"type": "integer", "minimum": 0},
          "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "sample_hashes": {"type": "array", "maxItems": 10, "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}}
        },
        "additionalProperties": false
      }
    },
    "category_match_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "raw_values_returned": {"const": false},
    "action": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
