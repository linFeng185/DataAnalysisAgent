{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "数值完整性审计输入",
  "type": "object",
  "required": ["rows", "rules"],
  "properties": {
    "rows": {"type": "array", "maxItems": 10000, "items": {"type": "object"}},
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["column"],
        "properties": {
          "column": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["number", "integer", "decimal", "money"], "default": "number"},
          "minimum": {"type": ["number", "null"], "default": null},
          "maximum": {"type": ["number", "null"], "default": null},
          "decimal_places": {"type": ["integer", "null"], "minimum": 0, "maximum": 18, "default": null},
          "rounding_mode": {"type": "string", "enum": ["half_even", "half_up", "down"], "default": "half_even"},
          "allow_null": {"type": "boolean", "default": true},
          "unit_column": {"type": ["string", "null"], "default": null},
          "expected_unit": {"type": ["string", "null"], "default": null}
        },
        "additionalProperties": false
      }
    },
    "max_findings": {"type": "integer", "minimum": 1, "maximum": 5000, "default": 500}
  },
  "additionalProperties": false
}
