{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "工作流状态差异输出",
  "type": "object",
  "required": ["valid", "identical", "summary", "differences", "differences_truncated", "protected_violations", "missing_required_fields", "missing_expected_changes", "persistence_mismatches", "before_fingerprint", "after_fingerprint"],
  "properties": {
    "valid": {"type": "boolean"},
    "identical": {"type": "boolean"},
    "summary": {
      "type": "object",
      "required": ["added", "removed", "changed", "unchanged", "total_differences"],
      "properties": {
        "added": {"type": "integer", "minimum": 0},
        "removed": {"type": "integer", "minimum": 0},
        "changed": {"type": "integer", "minimum": 0},
        "unchanged": {"type": "integer", "minimum": 0},
        "total_differences": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "differences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "change", "before", "after"],
        "properties": {
          "path": {"type": "string"},
          "change": {"type": "string", "enum": ["added", "removed", "changed"]},
          "before": {},
          "after": {}
        },
        "additionalProperties": false
      }
    },
    "differences_truncated": {"type": "boolean"},
    "protected_violations": {"type": "array", "items": {"type": "string"}},
    "missing_required_fields": {"type": "array", "items": {"type": "string"}},
    "missing_expected_changes": {"type": "array", "items": {"type": "string"}},
    "persistence_mismatches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "after", "persisted", "after_present", "persisted_present"],
        "properties": {
          "path": {"type": "string"},
          "after": {},
          "persisted": {},
          "after_present": {"type": "boolean"},
          "persisted_present": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "before_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "after_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
