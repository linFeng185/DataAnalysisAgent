{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "数据契约校验输出",
  "type": "object",
  "required": ["valid", "checked_rows", "checked_columns", "total_violations", "violations", "violation_counts", "violations_truncated", "contract_fingerprint"],
  "properties": {
    "valid": {"type": "boolean"},
    "checked_rows": {"type": "integer", "minimum": 0},
    "checked_columns": {"type": "integer", "minimum": 1},
    "total_violations": {"type": "integer", "minimum": 0},
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "row_index", "column", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "severity": {"const": "error"},
          "row_index": {"type": ["integer", "null"], "minimum": 0},
          "column": {"type": "string"},
          "message": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "violation_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "violations_truncated": {"type": "boolean"},
    "contract_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
