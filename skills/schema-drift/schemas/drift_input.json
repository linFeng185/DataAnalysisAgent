{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "结构漂移比较输入",
  "type": "object",
  "required": ["baseline", "current"],
  "$defs": {
    "snapshot": {
      "type": "object",
      "required": ["tables"],
      "properties": {
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "columns"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "columns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "type": {"type": "string", "default": "unknown"},
                    "nullable": {"type": "boolean", "default": true},
                    "default": {},
                    "description": {"type": "string", "default": ""}
                  },
                  "additionalProperties": false
                }
              },
              "primary_key": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "baseline": {"$ref": "#/$defs/snapshot"},
    "current": {"$ref": "#/$defs/snapshot"}
  },
  "additionalProperties": false
}
