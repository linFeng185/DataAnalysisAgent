{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "时间序列分析输入",
  "type": "object",
  "required": ["rows", "time_column", "value_column"],
  "properties": {
    "rows": {"type": "array", "minItems": 4, "maxItems": 10000, "items": {"type": "object"}},
    "time_column": {"type": "string", "minLength": 1},
    "value_column": {"type": "string", "minLength": 1},
    "horizon": {"type": "integer", "minimum": 1, "maximum": 30, "default": 3},
    "confidence_level": {"type": "number", "minimum": 0.5, "exclusiveMaximum": 1, "default": 0.8}
  },
  "additionalProperties": false
}
