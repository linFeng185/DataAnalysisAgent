{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SQL 诊断输入",
  "type": "object",
  "required": ["sql", "dialect"],
  "properties": {
    "sql": {"type": "string", "minLength": 1, "maxLength": 500000},
    "dialect": {"type": "string", "enum": ["clickhouse", "mysql", "postgres", "oracle", "mssql", "sqlite"]}
  },
  "additionalProperties": false
}
