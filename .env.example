# =============================================================================
# 环境变量模板：本文件只是模板，真实配置请复制为同目录 .env 后修改。
# 禁止把真实密钥写进本模板；.env 已被 .gitignore 忽略。
#
# 配置优先级（高 → 低）：
#   1. 进程环境变量（export 或 docker compose 注入）
#   2. .env 文件（本文件的副本）
#   3. config/app.yaml（统一 YAML 配置）
#   4. config/app.example.yaml（仓库内置模板，app.yaml 缺失时的兜底）
# APP_CONFIG_PATH 可指定统一 YAML 配置路径，见下方第一项。
#
# 注释格式：用途 | 默认值（不填时实际生效）| 生效范围
#   热生效 = 可用 PUT /admin/runtime-settings 立即修改（改本文件后仍需重启，
#            重启后新值才成为热改基线）
#   需重启 = 不在热改白名单内，修改后必须重启进程
# 值为 ${VAR} 时会引用本文件内已定义的其它变量（如 ${MYSQL_PASSWORD}）。
# =============================================================================

# ===== 运行环境 =====
# 用途：指定统一 YAML 配置路径，覆盖默认的 config/app.yaml | 默认值：空（按 config/app.yaml → config/app.example.yaml 顺序回退）| 生效范围：需重启
# 注意：一旦显式设置且文件不存在，将不再回退 example，全新 clone 会缺配置；不确定时请保持注释。
# APP_CONFIG_PATH=config/app.yaml
# 用途：运行环境，dev/prod/test；prod 会在启动时强制校验密钥强度与 DATABASE_URL | 默认值：prod | 生效范围：需重启
ENV=dev
# 用途：日志级别 DEBUG/INFO/WARNING/ERROR | 默认值：INFO | 生效范围：需重启
LOG_LEVEL=INFO
# 用途：日志输出格式，console 便于本地排查 / json 便于采集 | 默认值：console | 生效范围：需重启
LOG_FORMAT=console
# 用途：日志文件路径（由 TimedRotatingFileHandler 按天轮转保留 7 份）| 默认值：logs/app.log | 生效范围：需重启
LOG_FILE=logs/app.log

# ===== 可选密钥托管：默认保持现有配置；不得把真实密钥写进本模板 =====
# 用途：密钥来源渠道 environment 明文读取 / file 挂载文件 / vault 服务 | 默认值：environment | 生效范围：需重启
SECRET_PROVIDER=environment
# 用途：secret_provider=file 时的密钥 JSON 文件路径 | 默认值：空（不启用）| 生效范围：需重启
# SECRET_FILE=/run/secrets/data-agent.json
# 用途：secret_provider=vault 时切换托管；以下 VAULT_* 仅在取值 vault 时生效 | 默认值：environment（即不启用 Vault）| 生效范围：需重启
# SECRET_PROVIDER=vault
# 用途：Vault 服务地址 | 默认值：空 | 生效范围：需重启
# VAULT_ADDR=https://vault.internal.example
# 用途：Vault KV 挂载点 | 默认值：secret | 生效范围：需重启
# VAULT_MOUNT=secret
# 用途：Vault 中存放密钥的路径 | 默认值：空 | 生效范围：需重启
# VAULT_SECRET_PATH=data-agent/production
# 用途：Vault Token 文件路径（不放 token 明文到环境变量）| 默认值：空 | 生效范围：需重启
# VAULT_TOKEN_FILE=/run/secrets/vault-token
# 用途：Vault 服务端 CA 证书路径，用于自签证书校验 | 默认值：空 | 生效范围：需重启
# VAULT_CA_FILE=/run/secrets/vault-ca.pem
# 用途：Vault Enterprise 命名空间 | 默认值：空 | 生效范围：需重启
# VAULT_NAMESPACE=
# 用途：读取的密钥版本号，0 表示取最新版本 | 默认值：0 | 生效范围：需重启
# VAULT_SECRET_VERSION=0
# 用途：Vault 请求超时秒数 | 默认值：10 | 生效范围：需重启
# VAULT_TIMEOUT_SECONDS=10
# 用途：凭证加密密钥轮换标识，配合 credential_previous_keys 做版本化轮换 | 默认值：空 | 生效范围：需重启
# 版本化轮换的 key_id 和 previous_keys 优先从托管文件/服务读取。
# CREDENTIAL_KEY_ID=release-2026-09

# ===== LLM =====
# LLM 模型、服务地址和凭证统一在管理后台配置
# 用途：采样温度，越低越稳定 | 默认值：0.0 | 生效范围：热生效（PUT /admin/runtime-settings）
LLM_TEMPERATURE=0.0
# 用途：单次响应最大输出 Token 数 | 默认值：4096 | 生效范围：热生效（PUT /admin/runtime-settings）
LLM_MAX_TOKENS=4096
# 用途：远程模型单次请求超时秒数 | 默认值：60 | 生效范围：热生效（PUT /admin/runtime-settings）
LLM_TIMEOUT=60
# 用途：流式响应中相邻分片的最大间隔秒数，超时判定断流 | 默认值：30 | 生效范围：热生效（PUT /admin/runtime-settings）
LLM_STREAM_CHUNK_TIMEOUT=30
# 用途：显示公开业务过程摘要，不包含原始思维链 | 默认值：false | 生效范围：启动默认需重启，运行覆盖仅平台管理员通过 PUT /admin/runtime-settings 热改，后续聊天请求生效
CHAT_SHOW_ANALYSIS_PROCESS=false
# 用途：轻量节点（摘要、命名等）使用的低成本模型 | 默认值：gpt-4o-mini（本模板示例值为 deepseek-v4-pro）| 生效范围：热生效（PUT /admin/runtime-settings）
CHEAP_LLM_MODEL=deepseek-v4-pro

# 快速本地模型使用独立的 OpenAI-compatible 地址；未配置时轻量节点走确定性回退
# 用途：本地模型名；留空表示不启用本地模型 | 默认值：空 | 生效范围：需重启
# LOCAL_LLM_MODEL=qwen2.5:7b
# 用途：本地模型 OpenAI-compatible 基础地址 | 默认值：空 | 生效范围：需重启
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# 用途：本地模型 API Key，本地服务通常任意填 | 默认值：local | 生效范围：需重启
# LOCAL_LLM_API_KEY=local
# 用途：本地模型请求超时秒数 | 默认值：15 | 生效范围：热生效（PUT /admin/runtime-settings）
# LOCAL_LLM_TIMEOUT=15

# 远程任务授权策略；模型和凭证由管理后台维护
# 用途：允许发送到远程模型的任务清单，逗号分隔；空表示全部走本地/回退 | 默认值：generate_sql | 生效范围：热生效（PUT /admin/runtime-settings）
LLM_REMOTE_TASKS=generate_sql
# 用途：本地模型失败时是否允许回退到远程模型 | 默认值：false | 生效范围：热生效（PUT /admin/runtime-settings）
LLM_ALLOW_REMOTE_FALLBACK=false
# 用途：主模型不可用时的降级链，逗号分隔（例：gpt-4o,claude-sonnet-4-6）| 默认值：空（不降级）| 生效范围：需重启
# LLM_FALLBACK_CHAIN=gpt-4o,claude-sonnet-4-6

# ===== 智能体状态数据库 (PostgreSQL) =====
# 用途：智能体自身状态库连接串（用户、会话、记忆、报表等）| 默认值：空（必须配置）| 生效范围：需重启
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/data_agent
# 用途：启动时自动执行 migrations 迁移 | 默认值：true（prod 校验强制 true）| 生效范围：需重启
RUN_MIGRATIONS_ON_STARTUP=true

# ===== 长期记忆自进化 =====
# 用途：记忆晋升为长期知识所需的最小复用次数 | 默认值：3 | 生效范围：热生效（PUT /admin/runtime-settings）
KNOWLEDGE_EVOLUTION_PROMOTION_THRESHOLD=3

# ===== 向量存储 / ChromaDB =====
# 用途：向量库类型 chroma / milvus | 默认值：chroma | 生效范围：需重启
VECTOR_STORE_TYPE=chroma
# 切换到 Milvus 时设置 VECTOR_STORE_TYPE=milvus 并填写服务地址
# 用途：Milvus 服务地址 | 默认值：空 | 生效范围：需重启
# MILVUS_URI=http://localhost:19530
# 用途：ChromaDB 持久化目录 | 默认值：./chroma_data | 生效范围：需重启
CHROMA_PERSIST_DIR=./chroma_data
# 用途：ChromaDB 集合名 | 默认值：data_agent_knowledge | 生效范围：需重启
CHROMA_COLLECTION_NAME=data_agent_knowledge
# all-MiniLM-L6-v2 模型路径 (不带 onnx 子目录)，必须按本机环境配置
# 用途：本地嵌入模型目录，决定向量化质量 | 默认值：空（必须配置，否则向量检索不可用）| 生效范围：需重启
EMBEDDING_MODEL_PATH=

# ===== Redis =====
# 本机直连 Compose Redis；密码需与下方 REDIS_PASSWORD 保持一致
# 用途：Redis 连接串，用于限流、缓存与跨 Worker 协调 | 默认值：redis://localhost:6379/0 | 生效范围：需重启
REDIS_URL=redis://:change-me@localhost:6379/0

# ===== 数据源内容缓存 =====
# local: 单机 JSON 持久化；redis: 多实例共享
# 单实例可用 local；多实例部署必须改为 redis，避免各实例缓存不一致。
# 用途：数据源内容缓存后端 local / redis | 默认值：local | 生效范围：需重启
DATASOURCE_CACHE_BACKEND=local
# 用途：local 后端缓存目录 | 默认值：./data/cache/datasource | 生效范围：需重启
DATASOURCE_CACHE_DIR=./data/cache/datasource
# 用途：缓存条目存活秒数 | 默认值：604800（7 天）| 生效范围：需重启
DATASOURCE_CACHE_TTL_SECONDS=604800
# 用途：redis 后端的 key 前缀，便于多环境共用实例时隔离 | 默认值：data-agent:datasource-cache | 生效范围：需重启
DATASOURCE_CACHE_REDIS_PREFIX=data-agent:datasource-cache
# 用途：是否定时刷新数据源 Schema 缓存 | 默认值：true | 生效范围：需重启
SCHEMA_CACHE_REFRESH_ENABLED=true
# 用途：Schema 缓存刷新间隔秒数 | 默认值：3600 | 生效范围：需重启
SCHEMA_CACHE_REFRESH_INTERVAL_SECONDS=3600
# 用途：每个 Worker 同时运行的表结构同步任务数上限，超出后自动排队等待 | 默认值：3（允许 1-100）| 生效范围：热生效
MAX_SCHEMA_SYNC_CONCURRENT=3

# ===== Skill Registry（可选） =====
# 用途：远程 Skill 仓库地址，空表示只用本地目录 | 默认值：空 | 生效范围：需重启
SKILL_REGISTRY_URL=
# 用途：允许拉取 Skill 的可信主机，逗号分隔 | 默认值：空 | 生效范围：需重启
SKILL_REGISTRY_TRUSTED_HOSTS=
# 用途：单个 Skill 包体积上限（字节）| 默认值：10485760（10 MiB）| 生效范围：需重启
SKILL_REGISTRY_MAX_PACKAGE_BYTES=10485760

# ===== 主动洞察与定时报告 =====
# 用途：主动洞察与自动化总开关 | 默认值：true | 生效范围：需重启
AUTOMATION_ENABLED=true
# 用途：调度轮询间隔秒数（允许 10-3600）| 默认值：60 | 生效范围：需重启
AUTOMATION_POLL_INTERVAL_SECONDS=60
# ⚠️ 以下服务器级外发配置已废弃（通知渠道改为租户级配置，见 /api/v1/notifications/admin/channels）。
# 保留仅为兼容既有自动化任务链路，新部署请勿再填写；外部渠道默认不启用。
# 用途：报告外发 SMTP 服务器地址（已废弃，改用租户级通知渠道）| 默认值：空（不启用邮件外发）| 生效范围：需重启
AUTOMATION_SMTP_HOST=
# 用途：SMTP 端口（已废弃）| 默认值：587 | 生效范围：需重启
AUTOMATION_SMTP_PORT=587
# 用途：SMTP 是否启用 STARTTLS（已废弃）| 默认值：true | 生效范围：需重启
AUTOMATION_SMTP_STARTTLS=true
# 用途：SMTP 登录用户名（已废弃）| 默认值：空 | 生效范围：需重启
AUTOMATION_SMTP_USERNAME=
# 用途：SMTP 登录密码（已废弃；租户级密码加密入库）| 默认值：空 | 生效范围：需重启
AUTOMATION_SMTP_PASSWORD=
# 用途：邮件发件人地址（已废弃）| 默认值：空 | 生效范围：需重启
AUTOMATION_EMAIL_FROM=
# 用途：飞书群机器人 Webhook 地址（已废弃）| 默认值：空（不推送）| 生效范围：需重启
AUTOMATION_FEISHU_WEBHOOK_URL=
# 用途：Slack Incoming Webhook 地址（已废弃）| 默认值：空（不推送）| 生效范围：需重启
AUTOMATION_SLACK_WEBHOOK_URL=

# ===== 强制认证与可选租户隔离 =====
# 用途：多租户隔离开关，关闭时仍强制登录 | 默认值：false | 生效范围：需重启
# MULTI_TENANT=true
# 用途：是否开放公开注册接口 | 默认值：false | 生效范围：需重启
# REGISTRATION_ENABLED=false
# 用途：内置超级管理员用户名 | 默认值：admin | 生效范围：需重启
# SUPER_ADMIN_USERNAME=admin
# 用途：内置超级管理员初始密码，users.id=1 不存在时用它创建 | 默认值：空（首次启动必须注入）| 生效范围：需重启
# 变量本体在文件末尾「Docker Compose」段落定义，此处仅作说明，避免同名键重复定义。
# SUPER_ADMIN_PASSWORD=
# 用途：JWT 签名密钥，prod 要求至少 32 字符 | 默认值：空（必须配置）| 生效范围：需重启
# 变量本体在文件末尾「Docker Compose」段落定义，此处仅作说明，避免同名键重复定义。
# JWT_SECRET=change-this-to-random-32-bytes
# 用途：管理端点 API Key；留空表示管理端点不启用 Key 认证 | 默认值：空（不启用）| 生效范围：需重启
# ADMIN_API_KEY=change-this-to-random-32-bytes

# ===== API 浏览器安全 =====
# 用途：允许跨域的前端 origin，逗号分隔；空表示拒绝所有跨域，prod 禁止 * | 默认值：空 | 生效范围：需重启
# CORS_ALLOWED_ORIGINS=https://app.example.com
# 仅生产 HTTPS 响应生效
# 用途：HSTS 头的 max-age 秒数 | 默认值：31536000（1 年）| 生效范围：需重启
SECURITY_HSTS_SECONDS=31536000

# ===== 会话上下文（可选） =====
# 用途：上下文绝对上限 Token 数，0 表示按模型 context_window 动态计算 | 默认值：0 | 生效范围：热生效（PUT /admin/runtime-settings）
# CONTEXT_MAX_TOKENS=50000
# 用途：保持完整原文的最近轮次数量 | 默认值：5 | 生效范围：热生效（PUT /admin/runtime-settings）
# CONTEXT_HOT_TURNS=5
# 用途：保留摘要而非原文的较远轮次数量 | 默认值：20 | 生效范围：热生效（PUT /admin/runtime-settings）
# CONTEXT_WARM_TURNS=20

# ===== 分析器（可选） =====
# 分析数据投喂 LLM 的最大字符数，超限按比例均匀抽取，默认 50000
# 用途：单次分析投喂 LLM 的样本字符上限 | 默认值：50000 | 生效范围：热生效（PUT /admin/runtime-settings）
# ANALYSIS_DATA_MAX_CHARS=50000

# ===== 限流与资源上限 =====
# 用途：全局每小时查询次数上限 | 默认值：100 | 生效范围：热生效（PUT /admin/runtime-settings）
MAX_QUERIES_PER_HOUR=100
# 用途：单用户每小时登录次数上限 | 默认值：20 | 生效范围：热生效（PUT /admin/runtime-settings）
LOGIN_MAX_PER_HOUR=20
# 用途：每小时注册次数上限 | 默认值：10 | 生效范围：需重启
REGISTRATION_MAX_PER_HOUR=10
# 用途：连续登录失败多少次后锁定账号 | 默认值：5 | 生效范围：热生效（PUT /admin/runtime-settings）
LOGIN_LOCKOUT_THRESHOLD=5
# 用途：账号锁定时长（分钟）| 默认值：15 | 生效范围：热生效（PUT /admin/runtime-settings）
LOGIN_LOCKOUT_MINUTES=15
# 用途：单个自然语言问题的字符上限 | 默认值：8000 | 生效范围：热生效（PUT /admin/runtime-settings）
MAX_QUERY_CHARS=8000
# 用途：单条 SQL 的字符上限 | 默认值：20000 | 生效范围：热生效（PUT /admin/runtime-settings）
MAX_SQL_CHARS=20000
# 用途：单次查询可命中的数据源数量上限 | 默认值：5 | 生效范围：热生效（PUT /admin/runtime-settings）
MAX_DATASOURCES_PER_QUERY=5
# 用途：单次查询最大扫描行数 | 默认值：10000000 | 生效范围：热生效（PUT /admin/runtime-settings）
MAX_SCAN_ROWS=10000000
# 用途：单条 SQL 最大执行秒数 | 默认值：30 | 生效范围：热生效（PUT /admin/runtime-settings）
MAX_EXECUTION_TIME=30
# 用途：返回给分析器的结果行数上限 | 默认值：100000 | 生效范围：热生效（PUT /admin/runtime-settings）
MAX_RESULT_ROWS=100000
# 用途：统计类查询的结果行数上限 | 默认值：500000 | 生效范围：热生效（PUT /admin/runtime-settings）
MAX_STATS_ROWS=500000
# 用途：单个上传文件字节上限 | 默认值：20971520（20 MiB）| 生效范围：热生效（PUT /admin/runtime-settings）
MAX_UPLOAD_BYTES=20971520
# 用途：单次上传文件个数上限 | 默认值：20 | 生效范围：热生效（PUT /admin/runtime-settings）
MAX_UPLOAD_FILES=20
# 用途：单次上传总字节上限 | 默认值：104857600（100 MiB）| 生效范围：热生效（PUT /admin/runtime-settings）
MAX_UPLOAD_TOTAL_BYTES=104857600

# 允许访问私网的可信数据库主机、IP 或 CIDR；空值时仅允许全局可路由地址
# 用途：放开私网数据库访问的白名单，逗号分隔 | 默认值：空（仅允许公网可路由地址）| 生效范围：热生效（PUT /admin/runtime-settings）
# DATASOURCE_HOST_ALLOWLIST=clickhouse.internal,10.20.0.0/16

# ===== LangSmith =====
# 用途：是否上报 LangSmith 链路追踪 | 默认值：false | 生效范围：需重启
# LANGSMITH_TRACING=true
# 用途：LangSmith API Key | 默认值：空 | 生效范围：需重启
# LANGSMITH_API_KEY=ls__xxxxxxxx
# 用途：LangSmith 项目名 | 默认值：data-analysis-agent | 生效范围：需重启
# LANGSMITH_PROJECT=data-analysis-agent
# 用途：LangSmith 服务端点，支持自建 | 默认值：https://api.smith.langchain.com | 生效范围：需重启
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 用途：是否隐藏上报的输入内容（防泄漏业务数据）| 默认值：true | 生效范围：需重启
# LANGSMITH_HIDE_INPUTS=true
# 用途：是否隐藏上报的输出内容 | 默认值：true | 生效范围：需重启
# LANGSMITH_HIDE_OUTPUTS=true
# 用途：采样率 0.0-1.0 | 默认值：1.0 | 生效范围：需重启
# LANGSMITH_SAMPLING_RATE=1.0

# 受管 Skill 默认必须使用可信 Ed25519 签名；值为 key_id 到公钥的 JSON 映射
# 用途：受管/额外目录 Skill 是否强制校验签名 | 默认值：true | 生效范围：需重启
SKILL_REQUIRE_SIGNATURES=true
# 用途：可信签发者公钥映射（key_id → PEM/Base64 公钥），JSON 字符串 | 默认值：空（无可用公钥，受管/额外目录 Skill 的签名校验必然失败）| 生效范围：需重启
SKILL_TRUSTED_PUBLIC_KEYS={}
# 用途：是否发现 skills/community 下由父仓库 gitlink 固定的社区子模块 Skill（只读发现，运行期不联网）| 默认值：false | 生效范围：需重启
SKILL_COMMUNITY_SUBMODULES_ENABLED=false
# 用途：社区子模块允许的完整 HTTPS 仓库 URL 白名单，逗号分隔，须与 .gitmodules 声明逐字一致 | 默认值：空（无允许来源）| 生效范围：需重启
SKILL_COMMUNITY_ALLOWED_REPO_URLS=

# ===== MCP =====
# 用途：MCP 服务配置来源文件，通常与统一 YAML 同一份 | 默认值：config/app.yaml | 生效范围：需重启
MCP_CONFIG_PATH=config/app.yaml
# 数据库受管 SSE MCP 精确主机白名单，多个主机用逗号分隔
# 用途：允许连接的受管 SSE MCP 主机清单 | 默认值：空（全部拒绝）| 生效范围：热生效（PUT /admin/runtime-settings）
# MCP_REMOTE_HOST_ALLOWLIST=mcp.example.com,internal-mcp.example.net

# ===== Skills =====
# 内置 Skills 目录（始终加载，不受外部影响）
# 用途：内置 Skills 目录 | 默认值：skills | 生效范围：需重启
SKILLS_DIR=skills
# 用途：租户级/个人级 Skill 的受管根目录，上传的 Skill 写入此处 | 默认值：data/skills | 生效范围：需重启
MANAGED_SKILLS_DIR=data/skills
# 用途：额外的 Skills 搜索目录，分号分隔，上传时优先写入第一个目录 | 默认值：空 | 生效范围：需重启
# EXTRA_SKILLS_DIRS=/data/shared_skills;D:\team_skills

# ===== 凭证加密 =====
# Fernet 主密钥（至少 32 字符），生产环境必须显式配置且源码无默认值
# 非生产环境漏配时只生成进程级临时密钥，重启后无法解密持久化密文
# 生成: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 用途：数据源凭证等敏感字段的 Fernet 主密钥 | 默认值：空（必须配置）| 生效范围：需重启
# 变量本体在文件末尾「Docker Compose」段落定义，此处仅作说明，避免同名键重复定义。
# CREDENTIAL_ENCRYPTION_KEY=

# ===== 业务文档 =====
# 用途：指标口径等业务文档目录 | 默认值：docs/metrics | 生效范围：需重启
METRICS_DOCS_DIR=docs/metrics
# 系统知识只读目录，多个路径用分号分隔；启动时按 checksum 增量扫描
# 用途：系统知识库只读目录，分号分隔 | 默认值：空 | 生效范围：需重启
# SYSTEM_KNOWLEDGE_DIRS=docs/system;D:\shared\system_knowledge

# ===== 内置数据源 ORM 自发现（可选） =====
# 用途：Django 设置模块名，供内置 Provider 从 ORM 自动发现数据源 | 默认值：空（不做 ORM 自发现）| 生效范围：需重启
# DJANGO_SETTINGS_MODULE=myproject.settings

# ===== 造数 CLI（可选） =====
# 供 python -m src.testdata.cli / tests/import_test_data.py 使用；主应用不读取。
# 每个方言的 HOST/DATABASE/USER/PASSWORD 四项缺一即报错，PORT 省略时按下表默认端口。
# TESTDATA_MYSQL_* 端口默认 3306
# 用途：造数脚本连接的 MySQL 测试库主机 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_MYSQL_HOST=192.168.195.133
# 用途：造数脚本连接的 MySQL 端口 | 默认值：3306 | 生效范围：需重启（仅命令行读取）
# TESTDATA_MYSQL_PORT=3306
# 用途：造数脚本使用的 MySQL 库名 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_MYSQL_DATABASE=daa_test_retail
# 用途：造数脚本使用的 MySQL 用户名 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_MYSQL_USER=root
# 用途：造数脚本使用的 MySQL 密码 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_MYSQL_PASSWORD=${MYSQL_PASSWORD}
#
# TESTDATA_POSTGRES_* 端口默认 5432
# 用途：造数脚本连接的 PostgreSQL 测试库主机 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_POSTGRES_HOST=192.168.195.133
# 用途：造数脚本连接的 PostgreSQL 端口 | 默认值：5432 | 生效范围：需重启（仅命令行读取）
# TESTDATA_POSTGRES_PORT=5432
# 用途：造数脚本使用的 PostgreSQL 库名 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_POSTGRES_DATABASE=daa_test_finance
# 用途：造数脚本使用的 PostgreSQL 用户名 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_POSTGRES_USER=postgres
# 用途：造数脚本使用的 PostgreSQL 密码 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_POSTGRES_PASSWORD=${PG_PASSWORD}
#
# TESTDATA_MSSQL_* 端口默认 1433
# 用途：造数脚本连接的 SQL Server 测试库主机 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_MSSQL_HOST=192.168.195.133
# 用途：造数脚本连接的 SQL Server 端口 | 默认值：1433 | 生效范围：需重启（仅命令行读取）
# TESTDATA_MSSQL_PORT=1433
# 用途：造数脚本使用的 SQL Server 库名 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_MSSQL_DATABASE=daa_test_supply
# 用途：造数脚本使用的 SQL Server 用户名 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_MSSQL_USER=sa
# 用途：造数脚本使用的 SQL Server 密码 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_MSSQL_PASSWORD=${MSSQL_PASSWORD}
#
# TESTDATA_ORACLE_* 端口默认 1521
# 用途：造数脚本连接的 Oracle 测试库主机 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_ORACLE_HOST=192.168.195.133
# 用途：造数脚本连接的 Oracle 端口 | 默认值：1521 | 生效范围：需重启（仅命令行读取）
# TESTDATA_ORACLE_PORT=1521
# 用途：造数脚本使用的 Oracle 服务名/库名 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_ORACLE_DATABASE=XEPDB1
# 用途：造数脚本使用的 Oracle 用户名 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_ORACLE_USER=TEST_USER
# 用途：造数脚本使用的 Oracle 密码 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_ORACLE_PASSWORD=${ORACLE_PASSWORD}
#
# TESTDATA_CLICKHOUSE_* 端口默认 8123
# 用途：造数脚本连接的 ClickHouse 测试库主机 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_CLICKHOUSE_HOST=192.168.195.133
# 用途：造数脚本连接的 ClickHouse HTTP 端口 | 默认值：8123 | 生效范围：需重启（仅命令行读取）
# TESTDATA_CLICKHOUSE_PORT=8123
# 用途：造数脚本使用的 ClickHouse 库名 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_CLICKHOUSE_DATABASE=daa_test_insight
# 用途：造数脚本使用的 ClickHouse 用户名 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_CLICKHOUSE_USER=reader
# 用途：造数脚本使用的 ClickHouse 密码 | 默认值：空（必须显式配置）| 生效范围：需重启（仅命令行读取）
# TESTDATA_CLICKHOUSE_PASSWORD=${CLICKHOUSE_PASSWORD}

# ===== 数据源密码（供脚本与已废弃的 datasources.yaml 使用，主应用走数据源管理页） =====
# 用途：MySQL 测试库密码，被 tests/import_test_data.py 与 config/datasources.yaml 的 ${MYSQL_PASSWORD} 占位符引用 | 默认值：无（脚本使用前必须配置）| 生效范围：需重启（进程外脚本按需读取）
MYSQL_PASSWORD=your_mysql_password
# 用途：PostgreSQL 测试库密码，被 tests/import_test_data.py 与 config/datasources.yaml 的 ${PG_PASSWORD} 占位符引用 | 默认值：无（脚本使用前必须配置）| 生效范围：需重启（进程外脚本按需读取）
PG_PASSWORD=your_pg_password
# 用途：SQL Server 测试库密码，被 tests/import_test_data.py 与 config/datasources.yaml 的 ${MSSQL_PASSWORD} 占位符引用 | 默认值：无（脚本使用前必须配置）| 生效范围：需重启（进程外脚本按需读取）
MSSQL_PASSWORD=your_mssql_password

# ===== Docker Compose / Dockerfile（仅供容器编排使用，应用主流程不读取） =====
# 用途：后端镜像名，docker compose build 后复用 | 默认值：data-analysis-agent-backend:local | 生效范围：需重启（docker compose 展开时读取）
BACKEND_IMAGE=data-analysis-agent-backend:local
# 用途：前端镜像名 | 默认值：data-analysis-agent-frontend:local | 生效范围：需重启（docker compose 展开时读取）
FRONTEND_IMAGE=data-analysis-agent-frontend:local
# 用途：前端端口绑定地址，默认只监听本机 | 默认值：127.0.0.1 | 生效范围：需重启（docker compose 展开时读取）
FRONTEND_BIND_ADDRESS=127.0.0.1
# 用途：前端对外端口 | 默认值：8080 | 生效范围：需重启（docker compose 展开时读取）
FRONTEND_PORT=8080
# 用途：Dockerfile 构建时安装的可选依赖组 | 默认值：connectors,documents,structured | 生效范围：需重启（镜像构建参数）
INSTALL_EXTRAS=connectors,documents,structured
# 用途：Compose PostgreSQL 服务库名，需与 DATABASE_URL 一致 | 默认值：data_agent | 生效范围：需重启（仅供 compose 使用）
POSTGRES_DB=data_agent
# 用途：Compose PostgreSQL 服务用户名，需与 DATABASE_URL 一致 | 默认值：data_agent | 生效范围：需重启（仅供 compose 使用）
POSTGRES_USER=data_agent
# 用途：JWT 签名密钥，同时供应用与 compose 注入 | 默认值：空（prod 要求至少 32 字符）| 生效范围：需重启
JWT_SECRET=
# 用途：凭证加密 Fernet 主密钥，同时供应用与 compose 注入 | 默认值：空（prod 要求至少 32 字符）| 生效范围：需重启
CREDENTIAL_ENCRYPTION_KEY=
# 用途：内置超级管理员初始密码，compose 强制要求非空 | 默认值：空（首次部署必须设置）| 生效范围：需重启
SUPER_ADMIN_PASSWORD=
# 用途：Compose Redis 服务密码，需与 REDIS_URL 中的密码一致 | 默认值：change-me | 生效范围：需重启（仅供 compose 使用）
REDIS_PASSWORD=change-me
# 用途：本地 MySQL 服务 root 密码，仅供非 example 的 docker-compose.yml 使用 | 默认值：change-me | 生效范围：需重启（仅供本地 compose 使用）
MYSQL_ROOT_PASSWORD=change-me
# 用途：Compose PostgreSQL 服务密码，需与 DATABASE_URL 中的密码一致 | 默认值：change-me | 生效范围：需重启（仅供 compose 使用）
POSTGRES_PASSWORD=change-me
# 用途：Oracle 测试库密码，被 tests/import_test_data.py 与本地 compose 的 Oracle 服务引用 | 默认值：change-me | 生效范围：需重启（进程外脚本/compose 读取）
ORACLE_PASSWORD=change-me
# SQL Server 要求密码同时包含大小写字母、数字和符号。
# 用途：SQL Server sa 密码，仅供本地 docker-compose.yml 的 mssql 服务使用 | 默认值：无 | 生效范围：需重启（仅供本地 compose 使用）
SA_PASSWORD=replace_with_a_unique_Strong_Password_2026!
# 用途：ClickHouse 测试库密码，被 tests/import_test_data.py 与本地 compose 的 ClickHouse 服务引用 | 默认值：change-me | 生效范围：需重启（进程外脚本/compose 读取）
CLICKHOUSE_PASSWORD=change-me
# 用途：MinIO 访问密钥，仅供本地 docker-compose.yml 的对象存储服务使用 | 默认值：change-me | 生效范围：需重启（仅供本地 compose 使用）
MINIO_ACCESS_KEY=change-me
# 用途：MinIO 私有密钥，仅供本地 docker-compose.yml 的对象存储服务使用 | 默认值：change-me | 生效范围：需重启（仅供本地 compose 使用）
MINIO_SECRET_KEY=change-me

# ===== 可观测性栈（docker-compose.observability.yml 专用） =====
# 用途：Grafana 管理员用户名，仅 observability compose 生效 | 默认值：admin | 生效范围：需重启（仅供 observability compose 使用）
# GRAFANA_ADMIN_USER=admin
# 用途：Grafana 管理员密码，仅 observability compose 生效；该文件要求必须显式设置 | 默认值：无（compose 会报错要求设置）| 生效范围：需重启（仅供 observability compose 使用）
# GRAFANA_ADMIN_PASSWORD=change-me
